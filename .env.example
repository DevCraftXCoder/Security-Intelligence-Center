# =============================================================================
# SIC — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.
# =============================================================================

# Runtime: "production" for live deployments, anything else = development.
# Controls which Stripe price IDs are used and whether BILLING_API_KEY is required.
SIC_ENV=development

# Base URL of this server — used in redirect URLs and provisioning email links.
SIC_BASE_URL=http://localhost:9888

# =============================================================================
# Stripe
# =============================================================================

# Secret key — sk_test_... for development, sk_live_... for production.
# Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=

# Webhook signing secret — whsec_... from Stripe Dashboard > Webhooks > signing secret.
# For local testing, run:  stripe listen --forward-to localhost:9015/api/billing/webhook
# The CLI prints the whsec_... value to use here.
STRIPE_WEBHOOK_SECRET=

# Test-mode price IDs (used when SIC_ENV != "production").
# Stripe Dashboard > Products > SIC Team / SIC Studio > Pricing
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_STUDIO_YEARLY=

# Live-mode price IDs (used when SIC_ENV=production).
STRIPE_PRICE_TEAM_LIVE=
STRIPE_PRICE_TEAM_YEARLY_LIVE=
STRIPE_PRICE_STUDIO_LIVE=
STRIPE_PRICE_STUDIO_YEARLY_LIVE=

# Restriction key for Stripe CLI operations (rk_live_...).
# Never commit your actual key — placeholder only.
STRIPE_RESTRICTION_KEY=

# =============================================================================
# Billing API — M2M auth
# =============================================================================

# Shared secret between the Next.js proxy (SIC_BILLING_KEY env var on the
# francois-landing CF Worker) and this Flask server.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
BILLING_API_KEY=

# =============================================================================
# Provisioning email (Resend)
# =============================================================================

# Required to send magic-link emails after a customer pays.
# If unset, provisioning emails are skipped and a Discord alert fires instead.
# Obtain from resend.com dashboard > API Keys.
RESEND_API_KEY=

# Sender address for provisioning emails — must be a verified Resend domain.
SIC_ALERT_FROM=noreply@yourdomain.com

# =============================================================================
# Discord (optional)
# =============================================================================

# Webhook URL for billing alerts: payment failures, provisioning skips, invalid tier.
# Discord Server Settings > Integrations > Webhooks > New Webhook > Copy URL.
DISCORD_WEBHOOK_URL=

# =============================================================================
# Auth
# =============================================================================

# REQUIRED — comma-separated list of admin email addresses that can receive
# magic-link logins. Magic link auth returns 503 for ALL users if unset.
# Example:  SIC_ADMIN_EMAILS=alice@example.com,bob@example.com
SIC_ADMIN_EMAILS=

# REQUIRED in production — Flask session signing secret (HMAC-SHA256).
# SIC refuses to start with SIC_ENV=production if this is unset.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
SIC_SECRET_KEY=

# Secret used to sign and verify session tokens (HMAC-SHA256).
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
SIC_AUTH_SECRET=

# REQUIRED to be "off" in production — "open" bypasses billing auth and lets
# ANY email receive a magic link regardless of payment status.
# WARNING: SIC_ENV=production will refuse to start if this is not "off".
SIC_WAITLIST_MODE=off

# =============================================================================
# SSO — optional, studio tier only
# =============================================================================

# Base URL used in SAML Service Provider metadata and OIDC redirect URIs.
SIC_SSO_BASE_URL=http://localhost:9888

# SAML SP certificate and private key (PEM, single-line with \n).
# Leave blank if not using SAML.
SIC_SAML_SP_CERT=
SIC_SAML_SP_KEY=
